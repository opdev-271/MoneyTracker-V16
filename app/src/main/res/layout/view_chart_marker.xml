<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tooltip"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/text_marker_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tooltip_text"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="26. 7." />

    <TextView
        android:id="@+id/text_marker_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="↓ 100.00" />

    <TextView
        android:id="@+id/text_marker_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_coral"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="↑ 10.00" />

</LinearLayout>
