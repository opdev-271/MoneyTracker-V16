<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed sheet: hairline on top + sides only. The negative bottom inset pushes
     the shape's bottom stroke outside the drawable bounds, so the sheet has no hard
     line where it ends - it just runs off the bottom of the screen.

     Filled with the *page* color rather than the card color: the sheet's job is to
     hold a list of white transaction cards, and now that those cards have no outline,
     a white sheet behind them would swallow them whole. Page-colored, the rows read as
     cards floating on the page, which is the same relationship they already have on
     the all-transactions screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
        </shape>
    </item>
</layer-list>
