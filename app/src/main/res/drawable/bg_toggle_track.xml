<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Inverted gradient (dark at the top) so the track reads as a groove the
         selected pill sits in, rather than another raised surface. -->
    <gradient
        android:angle="270"
        android:endColor="@color/surface_variant_gradient_top"
        android:startColor="@color/surface_variant_gradient_bottom"
        android:type="linear" />
    <corners android:radius="999dp" />
</shape>
