<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- angle 270 = top -> bottom. Gradients are used instead of <solid> so the fill
         follows the corner radius; a tiled bitmap would spill past the rounded corners. -->
    <gradient
        android:angle="270"
        android:endColor="@color/card_gradient_bottom"
        android:startColor="@color/card_gradient_top"
        android:type="linear" />
    <corners android:radius="@dimen/card_corner_radius" />
    <stroke android:width="1dp" android:color="@color/card_stroke" />
</shape>
